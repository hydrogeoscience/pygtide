license: "MPL-2.0"
repository-code: "https://github.com/hydrogeoscience/pygtide"
url: "https://github.com/hydrogeoscience/pygtide"
keywords:
  - "Earth tides"
  - "gravitational tides"
  - "ETERNA PREDICT"
  - "geophysics"
  - "Python"
